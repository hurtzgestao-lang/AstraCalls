POSTGRES_PASSWORD=replace-with-a-long-random-password
WACALLS_API_KEY=replace-with-a-long-random-api-key
ASTRACALLS_ENABLED=true
ASTRACALLS_IMAGE=ghcr.io/hurtzgestao-lang/astracalls@sha256:replace-with-published-digest
